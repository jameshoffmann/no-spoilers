{
  "manifest_version": 3,
  "name": "No spoilers!",
  "version": "1.6",
  "description": "Hides the progress bar and timestamps on SOOP and YouTube videos and adds customizable rewind/fast-forward buttons and arrow-key seeking.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.sooplive.com/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "No spoilers!", "default_popup": "options.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://*.sooplive.com/*", "https://www.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
